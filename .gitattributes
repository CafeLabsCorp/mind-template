# Texto sempre com LF, em qualquer sistema: evita CRLF do Windows e diff fantasma.
* text=auto eol=lf

# Binários: nunca converter (e de qualquer forma o .gitignore os mantém fora do repo).
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.mp4 binary
*.mov binary
*.zip binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
