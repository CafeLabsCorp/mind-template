{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "${CLAUDE_PROJECT_DIR}/scripts/mind.py",
              "hook",
              "session-start"
            ]
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Read(**)",
      "Write(**/*.md)",
      "Edit(**/*.md)",
      "Read(~/.claude/**)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git mv *)",
      "Bash(git fetch upstream)",
      "Bash(git fetch upstream *)",
      "Bash(python scripts/mind.py buscar *)",
      "Bash(python scripts/mind.py orfaos)",
      "Bash(python scripts/mind.py tamanho *)",
      "Bash(python scripts/mind.py vault)",
      "Bash(python scripts/mind.py template)",
      "Bash(python scripts/mind.py status)",
      "Bash(python scripts/mind.py setup)",
      "Bash(python scripts/mind.py mensagens)",
      "Bash(python scripts/mind.py mensagens *)",
      "Bash(git clone *)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/secrets/**)",
      "Bash(sudo:*)",
      "Bash(rm -rf *)",
      "Bash(curl:*)",
      "Bash(wget:*)"
    ],
    "ask": [
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git init *)",
      "Bash(git branch *)"
    ]
  }
}
